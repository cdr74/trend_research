# Environment Configuration for AI Test Engineering Horizon Radar

# Database (PostgreSQL 16 with pgvector via Podman)
RADAR_DATABASE_URL=postgresql+asyncpg://radar:radar_secret@localhost:5432/radar_db

# LLM Provider: "gemini" | "openai_compat" | "ollama" | "mock"
RADAR_LLM_PROVIDER=mock
RADAR_EMBEDDING_PROVIDER=mock

# Google Gemini Settings (required if RADAR_LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# OpenAI / vLLM / Ollama Settings (required if RADAR_LLM_PROVIDER=openai_compat or ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL_NAME=llama3.2

# Logging & Pipeline Defaults
LOG_LEVEL=INFO
RADAR_BATCH_SIZE=20
